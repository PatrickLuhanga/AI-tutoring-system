# Client Tier configuration.
#
# Mock mode is OFF by default so the UI talks to the real Flask API Gateway
# (Vite proxies /api -> http://localhost:5000). Set VITE_USE_MOCK=true only to
# run the UI with canned data and no backend.
VITE_USE_MOCK=false

# Sent as the X-Admin-Key header on /api/admin/* requests. This MUST match
# ADMIN_API_KEY in the backend .env or every /api/admin/* call returns 401.
VITE_ADMIN_KEY=local-dev-admin-key
