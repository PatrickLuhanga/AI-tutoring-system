# Client Tier configuration.
#
# Mock mode ships ON so the UI runs with no backend. Set VITE_USE_MOCK=false
# once the Flask API Gateway is running (Vite proxies /api -> http://localhost:5000).
VITE_USE_MOCK=true

# Sent as the X-Admin-Key header on /api/admin/* requests. This MUST match
# ADMIN_API_KEY in the backend .env or every /api/admin/* call returns 401.
VITE_ADMIN_KEY=local-dev-admin-key
