# Client Tier configuration.
#
# Mock mode ships ON so the UI runs with no backend. Set VITE_USE_MOCK=false
# once the Flask API Gateway is running (Vite proxies /api -> http://localhost:5000).
VITE_USE_MOCK=true

# Sent as the X-Admin-Key header on /api/admin/* requests.
# MUST match the backend ADMIN_API_KEY (root .env) or the dashboard gets 401.
VITE_ADMIN_KEY=change-me-admin-key

# --- Microsoft Entra ID (DUT4life) SSO -------------------------------------
# Set both to enable the "Sign in with Microsoft" button. Must match the
# backend AZURE_TENANT_ID / AZURE_CLIENT_ID (root .env) for AUTH_MODE=strict.
# The popup flow requests an access token which is sent as Authorization: Bearer.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
# Optional: override the requested scopes (space/comma separated). Defaults to
# api://<VITE_AZURE_CLIENT_ID>/access_as_user.
VITE_AZURE_SCOPES=
