# Environment / secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Tooling / OS
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.log
.DS_Store
Thumbs.db

# Model caches (downloaded by sentence-transformers)
models/
.cache/

academic content/
# Anchored on purpose. Unanchored, `corpora/` also matched `src/corpora/` at any
# depth, which silently swallowed src/corpora/java_error_corpus.py - source, not
# a cache - so `python -m src.ingest_code_patterns` failed with ModuleNotFoundError
# on every clone. See LOCAL_SETUP_NOTES.md section 3.
/corpora/
venv/
.venv/

# Evaluation run artefacts: logs and per-turn JSON from eval/run_*_eval.py.
# The harness and the labelled test set are tracked; a run's output is not.
eval/results/

# OCR text cached from exam_papers/*.pdf, keyed by file content hash. Derived
# from tracked PDFs and expensive to produce (minutes per paper on CPU), but
# machine-specific and large - regenerate by running:
#   python -m src.seed_exam_questions exam_papers --dry-run
exam_papers/.ocr-cache/