# Anchored on purpose. Unanchored, `corpora/` also matched `src/corpora/` at any
# depth, which silently swallowed src/corpora/java_error_corpus.py - source, not
# a cache - so `python -m src.ingest_code_patterns` failed with ModuleNotFoundError
# on every clone. See LOCAL_SETUP_NOTES.md section 3.
/corpora/
venv/
.venv/

# Evaluation run artefacts: logs and per-turn JSON from eval/run_*_eval.py.
# The harness and the labelled test set are tracked; a run's output is not.
eval/results/