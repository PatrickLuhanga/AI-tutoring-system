# ===========================================================================
# Hybrid AI Tutoring System - Hybrid Data Tier configuration
# Copy this file to `.env` and adjust the values for your machine.
# ===========================================================================

# --- PostgreSQL connection -------------------------------------------------
# Provide EITHER a full DATABASE_URL OR the individual components below.
# NOTE: port 5433 is used by default so this project does not clash with a
# PostgreSQL instance already listening on the standard 5432 port. Change it if
# 5432 is free on your machine.
# DATABASE_URL=postgresql+psycopg2://tutor_admin:tutor_password@localhost:5433/ai_tutoring
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ai_tutoring
POSTGRES_USER=tutor_admin
POSTGRES_PASSWORD=tutor_password

# Schema that owns the data-tier tables.
DB_SCHEMA=public

# Per-statement wall-clock budget (milliseconds) applied to every connection via
# PostgreSQL `statement_timeout`. A runaway analytics/retrieval query is aborted
# server-side instead of pinning a worker. 0 disables the timeout.
DB_STATEMENT_TIMEOUT_MS=10000

# --- Embedding model -------------------------------------------------------
# nomic-embed-text served by local Ollama (architecture doc, section 10.3).
# Produces 768-dimensional instruct embeddings; document and query inputs use
# different task prefixes (see below).
EMBEDDING_MODEL_NAME=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64
EMBEDDING_NORMALIZE=true
# Backend: `ollama` (nomic-embed-text via local Ollama - the working default),
# `sentence-transformers` (a local HuggingFace model such as all-MiniLM-L6-v2),
# or `hash` (a deterministic offline stub used only to smoke-test the pipeline -
# never use it for real retrieval).
EMBEDDING_BACKEND=ollama
# nomic-embed-text task prefixes (instruct-style embeddings):
#   documents are ingested with EMBEDDING_DOC_PREFIX, queries are encoded with
#   EMBEDDING_QUERY_PREFIX. Keep them in sync with the model card.
EMBEDDING_DOC_PREFIX=search_document:
EMBEDDING_QUERY_PREFIX=search_query:

# --- Curriculum ingestion --------------------------------------------------
# Relative paths are resolved against the project root.
ACADEMIC_CONTENT_DIR=academic content
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Vector indexes --------------------------------------------------------
# VECTOR_INDEX_TYPE: hnsw (pgvector >= 0.5) or ivfflat.
VECTOR_INDEX_TYPE=hnsw
VECTOR_INDEX_LISTS=100
VECTOR_INDEX_M=16
VECTOR_INDEX_EF_CONSTRUCTION=64

# ===========================================================================
# Tier 2 - Orchestration Tier (Flask API gateway + multi-agent RAG workflow)
# ===========================================================================

# --- Flask gateway ---------------------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
# Comma-separated origins allowed to call the API from a browser ("*" = any).
CORS_ALLOWED_ORIGINS=*

# --- Authentication --------------------------------------------------------
# dev    -> role/email are read from the X-User-Email / X-User-Role headers
#           (or the JSON body) and matched against the students table.
# strict -> every request must carry a Microsoft Entra ID (Azure AD) access
#           token; it is verified against the tenant JWKS and the dev headers
#           are ignored entirely.
AUTH_MODE=dev
# Microsoft Entra ID (DUT4life) application registration. Required when
# AUTH_MODE=strict: the SPA sends an access token (Authorization: Bearer) and
# the gateway pins its audience/issuer to these two values.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Shared secret required in the X-Admin-Key header for /api/admin/*.
# CHANGE THIS before exposing the server to a network.
ADMIN_API_KEY=change-me-admin-key
# Any valid address in this domain self-provisions a profile on first login.
ALLOWED_EMAIL_DOMAIN=dut4life.ac.za
# Comma-separated allowlist of addresses auto-provisioned with the admin role.
ADMIN_EMAILS=admin.system@dut4life.ac.za
# Block students from using modules they are not enrolled in.
ENFORCE_ENROLLMENT=false

# --- Dynamic LLM Router ----------------------------------------------------
# Active provider at first boot: `local` (Ollama) or `cloud`.
LLM_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LOCAL_MODEL=qwen3:4b
DEFAULT_CLOUD_PROVIDER=openai
DEFAULT_CLOUD_BASE_URL=https://api.openai.com/v1
DEFAULT_CLOUD_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT=120
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1024
LLM_TOP_P=0.9
# Master key used to encrypt cloud API keys before they are stored in the DB.
# Set a strong, unique value in production (any long string/passphrase works,
# or a 44-char Fernet key).
LLM_CONFIG_SECRET_KEY=
# Ask the LLM to classify intent (falls back to heuristics on any failure).
INTENT_USE_LLM=true
# Ground the LLM intent classifier with the generated few-shot registry
# (src/agents/few_shot_registry.json). Missing file -> heuristics only.
INTENT_USE_FEW_SHOTS=true

# --- Inference-tier fault isolation (Ollama circuit breaker) ---------------
# After this many consecutive transport failures the breaker opens and the API
# fails fast instead of stacking up timeouts.
OLLAMA_CIRCUIT_FAILURE_THRESHOLD=3
# Seconds the breaker stays open before allowing a single half-open probe.
OLLAMA_CIRCUIT_RESET_TIMEOUT=30
# Short timeout used by /api/health?deep=1 and the Ollama model dropdown.
OLLAMA_HEALTH_TIMEOUT=5


# --- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_CODE_TOP_K=3

# --- Hybrid retrieval (tsvector full-text + pgvector semantic + RRF) -------
# Ported from the StatSSA Rafiki RAG design. Keyword candidates are matched
# through the generated content_tsv column AND a pg_trgm substring sweep (for
# camelCase identifiers), ranked by IDF-weighted term coverage + ts_rank_cd,
# then fused with the gated semantic branch via Reciprocal Rank Fusion.
RETRIEVAL_HYBRID_ENABLED=true
# RRF smoothing constant: score contribution = weight / (RRF_K + rank).
RETRIEVAL_RRF_K=60
# Min cosine similarity for a semantic hit when the query has a lexical anchor.
RETRIEVAL_MIN_SIMILARITY=0.55
# Stricter gate when the query shares no discriminative term with the corpus.
RETRIEVAL_STRICT_SIMILARITY=0.78
# Terms occurring in more than this fraction of a module's source documents
# are non-discriminative and dropped from the keyword branch.
RETRIEVAL_MAX_DF_RATIO=0.45
# Candidate pool fetched from each branch before RRF fusion; the final ranking
# is still cut to RETRIEVAL_TOP_K.
RETRIEVAL_CANDIDATE_POOL=40
# Relaxed similarity floor used only for the candidate fetch (when the query has
# a lexical anchor), so mid-similarity (0.55-0.60) chunks reach fusion instead
# of being dropped by RETRIEVAL_MIN_SIMILARITY up front.
RETRIEVAL_CANDIDATE_MIN_SIMILARITY=0.45
# Keyword candidate pool = max(top_k * factor, min_pool, candidate_pool).
RETRIEVAL_HYBRID_POOL_FACTOR=6
RETRIEVAL_HYBRID_MIN_POOL=20
# RRF branch weights.
RETRIEVAL_KEYWORD_WEIGHT=1.0
RETRIEVAL_VECTOR_WEIGHT=1.0

# --- Guardrail thresholds (implementation decisions - see README) ----------
GUARDRAIL_ENABLED=true
GUARDRAIL_MAX_CODE_LINES=8
GUARDRAIL_MAX_WORDS=400
GUARDRAIL_MIN_CONTEXT_OVERLAP=0.08
# block -> replace a leaking response with a Socratic fallback
# truncate -> strip code blocks / direct answers from the response
GUARDRAIL_ACTION=block

# --- Scaffolding Engine (dynamic attempt evaluation) -----------------------
# The hint stage advances / holds / steps back from the student's latest attempt
# (semantic quality + structural effort), never from a raw turn counter.
# engagement = 0.5 * semantic_quality + 0.5 * effort
#   (quality is omitted, and effort used alone, when it cannot be measured).
SCAFFOLDING_ADVANCE_THRESHOLD=0.45
SCAFFOLDING_RETREAT_THRESHOLD=0.18
# Minimum words for a reply to count as an attempt; length that saturates effort.
SCAFFOLDING_MIN_ATTEMPT_WORDS=3
SCAFFOLDING_EFFORT_FULL_WORDS=25
# Characters of retrieved material embedded for the semantic-quality signal.
SCAFFOLDING_CONTEXT_CHAR_BUDGET=2000
