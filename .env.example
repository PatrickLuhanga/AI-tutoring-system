# ===========================================================================
# Hybrid AI Tutoring System - Hybrid Data Tier configuration
# Copy this file to `.env` and adjust the values for your machine.
# ===========================================================================

# --- PostgreSQL connection -------------------------------------------------
# Provide EITHER a full DATABASE_URL OR the individual components below.
# NOTE: port 5433 is used by default so this project does not clash with a
# PostgreSQL instance already listening on the standard 5432 port. Change it if
# 5432 is free on your machine.
# DATABASE_URL=postgresql+psycopg2://tutor_admin:tutor_password@localhost:5433/ai_tutoring
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ai_tutoring
POSTGRES_USER=tutor_admin
POSTGRES_PASSWORD=tutor_password

# Schema that owns the data-tier tables.
DB_SCHEMA=public

# --- Embedding model -------------------------------------------------------
# Free, local, CPU-friendly. Produces 384-dimensional vectors.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64
EMBEDDING_NORMALIZE=true
# Backend: `sentence-transformers` (real embeddings) or `hash`
# (`hash` is a deterministic offline stub used only to smoke-test the pipeline
#  when the ML stack is not installed - never use it for real retrieval).
EMBEDDING_BACKEND=sentence-transformers

# --- Curriculum ingestion --------------------------------------------------
# Relative paths are resolved against the project root.
ACADEMIC_CONTENT_DIR=academic content
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Vector indexes --------------------------------------------------------
# VECTOR_INDEX_TYPE: hnsw (pgvector >= 0.5) or ivfflat.
VECTOR_INDEX_TYPE=hnsw
VECTOR_INDEX_LISTS=100
VECTOR_INDEX_M=16
VECTOR_INDEX_EF_CONSTRUCTION=64

# ===========================================================================
# Tier 2 - Orchestration Tier (Flask API gateway + multi-agent RAG workflow)
# ===========================================================================

# --- Flask gateway ---------------------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
# Comma-separated origins allowed to call the API from a browser ("*" = any).
CORS_ALLOWED_ORIGINS=*

# --- Authentication --------------------------------------------------------
# dev    -> role/email are read from the X-User-Email / X-User-Role headers
#           (or the JSON body) and matched against the students table.
# strict -> the DUT4life identity provider must be wired up in auth.py.
AUTH_MODE=dev
# Shared secret required in the X-Admin-Key header for /api/admin/*.
# CHANGE THIS before exposing the server to a network.
# MUST match VITE_ADMIN_KEY in frontend/.env, or every /api/admin/* call 401s -
# including the model dropdown on the Admin dashboard.
ADMIN_API_KEY=local-dev-admin-key
# Block students from using modules they are not enrolled in.
ENFORCE_ENROLLMENT=false

# --- Dynamic LLM Router ----------------------------------------------------
# Active provider at first boot: `local` (Ollama) or `cloud`.
LLM_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
# Local model. Prefer a NON-reasoning model (qwen2.5, llama3.2-instruct,
# gemma-instruct) over qwen3 / deepseek-r1 on a CPU-only host: reasoning models
# spend part of num_predict on a thinking channel, which made turns take ~196s
# and returned empty replies outright 21% of the time.
DEFAULT_LOCAL_MODEL=qwen2.5:3b-instruct
DEFAULT_CLOUD_PROVIDER=openai
DEFAULT_CLOUD_BASE_URL=https://api.openai.com/v1
DEFAULT_CLOUD_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT=120
LLM_TEMPERATURE=0.4
# A Socratic hint is short by design. qwen3/deepseek-r1 are REASONING models:
# they spend part of num_predict on a thinking channel, so this must cover
# thinking + answer or the reply returns truncated/empty. With a non-reasoning
# model, 256 is comfortably enough for a hint.
LLM_MAX_TOKENS=512
LLM_TOP_P=0.9
# Master key used to encrypt cloud API keys before they are stored in the DB.
# Set a strong, unique value in production (any long string/passphrase works,
# or a 44-char Fernet key).
LLM_CONFIG_SECRET_KEY=
# Ask the LLM to classify intent (falls back to heuristics on any failure).
# This is a SECOND full generation per turn. Keep it false on CPU-only hardware.
INTENT_USE_LLM=false

# --- Inference-tier fault isolation (Ollama circuit breaker) ---------------
# After this many consecutive transport failures the breaker opens and the API
# fails fast instead of stacking up timeouts.
OLLAMA_CIRCUIT_FAILURE_THRESHOLD=3
# Seconds the breaker stays open before allowing a single half-open probe.
OLLAMA_CIRCUIT_RESET_TIMEOUT=30
# Short timeout used by /api/health?deep=1 and the Ollama model dropdown.
OLLAMA_HEALTH_TIMEOUT=5
# Reasoning models (qwen3, deepseek-r1, ...) emit a `thinking` channel before
# the answer. With this on they can burn the whole LLM_MAX_TOKENS budget
# reasoning and return an empty response. Keep false for a Socratic tutor.
OLLAMA_THINK=false


# --- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=3
RETRIEVAL_CODE_TOP_K=3
# Cosine-distance ceiling for a retrieved chunk to be trusted. A chunk further
# away than this is treated as "no relevant course material" instead of being
# pasted into the prompt. 0 disables the floor.
RETRIEVAL_MAX_DISTANCE=0.75
# Third-party material (source_category=books, e.g. commercial textbooks) is
# excluded by default so the tutor prefers faculty-approved course material.
RETRIEVAL_INCLUDE_THIRD_PARTY=false
# If the module's own material returns fewer than RETRIEVAL_TOP_K chunks, retry
# including third-party content rather than answering with a near-empty context.
RETRIEVAL_THIRD_PARTY_FALLBACK=true
# pgvector HNSW behaviour under a metadata filter. With iterative_scan=off, HNSW
# can return fewer rows than top_k when a module filter is selective. Requires
# pgvector >= 0.8. Measured cost at 3.5k chunks: ~2.6 ms per query.
HNSW_ITERATIVE_SCAN=strict_order
HNSW_EF_SEARCH=80
# Adaptive retrieval. An abstract question ("why is duplication bad?") often
# names a concept the notes DO teach but in different words, so it lands outside
# the distance floor. When a first pass is this weak, the question is rewritten
# into alternative phrasings, grounded in the module's section titles, and the
# runs are fused. Costs one extra generation, only on weak turns.
# Effectiveness is bounded by how informative those section titles are.
RETRIEVAL_EXPAND_ON_WEAK=true
RETRIEVAL_WEAK_DISTANCE=0.55
# How many section titles ground the rewrite, biggest sections first. These are
# prefilled into the rewrite prompt, and on a CPU-only host 60 titles measured
# ~374 words of prefill and 72s per call. 20 keeps it to ~80-110 words and ~15-22s.
RETRIEVAL_EXPAND_TITLES=20

# --- Guardrail thresholds (implementation decisions - see README) ----------
GUARDRAIL_ENABLED=true
GUARDRAIL_MAX_CODE_LINES=8
GUARDRAIL_MAX_WORDS=400
GUARDRAIL_MIN_CONTEXT_OVERLAP=0.08
# block -> replace a leaking response with a Socratic fallback
# truncate -> strip code blocks / direct answers from the response
GUARDRAIL_ACTION=block
