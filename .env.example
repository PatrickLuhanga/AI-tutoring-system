# ===========================================================================
# Hybrid AI Tutoring System - Hybrid Data Tier configuration
# Copy this file to `.env` and adjust the values for your machine.
# ===========================================================================

# --- PostgreSQL connection -------------------------------------------------
# Provide EITHER a full DATABASE_URL OR the individual components below.
# NOTE: port 5433 is used by default so this project does not clash with a
# PostgreSQL instance already listening on the standard 5432 port. Change it if
# 5432 is free on your machine.
# DATABASE_URL=postgresql+psycopg2://tutor_admin:tutor_password@localhost:5433/ai_tutoring
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ai_tutoring
POSTGRES_USER=tutor_admin
POSTGRES_PASSWORD=tutor_password

# Schema that owns the data-tier tables.
DB_SCHEMA=public

# --- Embedding model -------------------------------------------------------
# nomic-embed-text served by local Ollama (architecture doc, section 10.3).
# Produces 768-dimensional instruct embeddings; document and query inputs use
# different task prefixes (see below).
EMBEDDING_MODEL_NAME=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64
EMBEDDING_NORMALIZE=true
# Backend: `ollama` (nomic-embed-text via local Ollama - the working default),
# `sentence-transformers` (a local HuggingFace model such as all-MiniLM-L6-v2),
# or `hash` (a deterministic offline stub used only to smoke-test the pipeline -
# never use it for real retrieval).
EMBEDDING_BACKEND=ollama
# nomic-embed-text task prefixes (instruct-style embeddings):
#   documents are ingested with EMBEDDING_DOC_PREFIX, queries are encoded with
#   EMBEDDING_QUERY_PREFIX. Keep them in sync with the model card.
EMBEDDING_DOC_PREFIX=search_document:
EMBEDDING_QUERY_PREFIX=search_query:

# --- Curriculum ingestion --------------------------------------------------
# Relative paths are resolved against the project root.
ACADEMIC_CONTENT_DIR=academic content
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Vector indexes --------------------------------------------------------
# VECTOR_INDEX_TYPE: hnsw (pgvector >= 0.5) or ivfflat.
VECTOR_INDEX_TYPE=hnsw
VECTOR_INDEX_LISTS=100
VECTOR_INDEX_M=16
VECTOR_INDEX_EF_CONSTRUCTION=64

# ===========================================================================
# Tier 2 - Orchestration Tier (Flask API gateway + multi-agent RAG workflow)
# ===========================================================================

# --- Flask gateway ---------------------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
# Comma-separated origins allowed to call the API from a browser ("*" = any).
CORS_ALLOWED_ORIGINS=*

# --- Authentication --------------------------------------------------------
# dev    -> role/email are read from the X-User-Email / X-User-Role headers
#           (or the JSON body) and matched against the students table.
# strict -> the DUT4life identity provider must be wired up in auth.py.
AUTH_MODE=dev
# Shared secret required in the X-Admin-Key header for /api/admin/*.
# CHANGE THIS before exposing the server to a network.
ADMIN_API_KEY=change-me-admin-key
# Block students from using modules they are not enrolled in.
ENFORCE_ENROLLMENT=false

# --- Dynamic LLM Router ----------------------------------------------------
# Active provider at first boot: `local` (Ollama) or `cloud`.
LLM_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LOCAL_MODEL=qwen3:4b
DEFAULT_CLOUD_PROVIDER=openai
DEFAULT_CLOUD_BASE_URL=https://api.openai.com/v1
DEFAULT_CLOUD_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT=120
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1024
LLM_TOP_P=0.9
# Master key used to encrypt cloud API keys before they are stored in the DB.
# Set a strong, unique value in production (any long string/passphrase works,
# or a 44-char Fernet key).
LLM_CONFIG_SECRET_KEY=
# Ask the LLM to classify intent (falls back to heuristics on any failure).
INTENT_USE_LLM=true

# --- Inference-tier fault isolation (Ollama circuit breaker) ---------------
# After this many consecutive transport failures the breaker opens and the API
# fails fast instead of stacking up timeouts.
OLLAMA_CIRCUIT_FAILURE_THRESHOLD=3
# Seconds the breaker stays open before allowing a single half-open probe.
OLLAMA_CIRCUIT_RESET_TIMEOUT=30
# Short timeout used by /api/health?deep=1 and the Ollama model dropdown.
OLLAMA_HEALTH_TIMEOUT=5


# --- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_CODE_TOP_K=3

# --- Guardrail thresholds (implementation decisions - see README) ----------
GUARDRAIL_ENABLED=true
GUARDRAIL_MAX_CODE_LINES=8
GUARDRAIL_MAX_WORDS=400
GUARDRAIL_MIN_CONTEXT_OVERLAP=0.08
# block -> replace a leaking response with a Socratic fallback
# truncate -> strip code blocks / direct answers from the response
GUARDRAIL_ACTION=block
